# Netlify 缓存策略：静态资源一年 immutable（URL 均带 ?v= 版本号，内容变更通过升级 source_version 失效）
# HTML / atom.xml / content.json 走 Netlify 默认的 max-age=0, must-revalidate（配合 ETag 304）
/scripts/*
  Cache-Control: public, max-age=31536000, immutable

/css/*
  Cache-Control: public, max-age=31536000, immutable

/lib/*
  Cache-Control: public, max-age=31536000, immutable

/font/*
  Cache-Control: public, max-age=31536000, immutable

/intro/*
  Cache-Control: public, max-age=31536000, immutable

/avatar/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# feed 用标准 Atom MIME 类型，便于阅读器/浏览器扩展识别
/atom.xml
  Content-Type: application/atom+xml
